@model PortfolioHomeViewModel

<section id="home">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left Content -->
            <div class="col-lg-7 reveal-on-scroll">
                <div class="hero-badge">
                    <span>👋</span> @(Model.About?.JobTitle ?? ViewBag.title)
                </div>

                <h1 class="hero-title">
                    Merhaba, Ben <span class="hero-name-gradient">@(Model.About?.NameSurname ?? ViewBag.subtitle ?? Model.DisplayName)</span>.
                </h1>

                <!-- Animated Typing Text Slider -->
                <div class="typing-container" aria-live="polite">
                    <span id="typedText"></span><span class="typing-cursor"></span>
                </div>

                <p class="hero-desc">
                    @(ViewBag.description ?? Model.About?.Description)
                </p>

                <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                    <a href="#projects" class="btn-custom-primary">
                        <i class="bi bi-grid-fill"></i>
                        Projelerimi İncele
                    </a>
                    <a href="#contact" class="btn-custom-outline">
                        <i class="bi bi-chat-dots"></i>
                        Benimle İletişime Geç
                    </a>
                </div>

                <!-- Social Links -->
                <div class="d-flex align-items-center gap-2 pt-2">
                    <span class="text-secondary small fw-medium me-2">Bağlantılar:</span>
                    @foreach (var link in Model.SocialLinks)
            {
                if (Uri.TryCreate(link.Url, UriKind.Absolute, out var url) && url.Scheme is "http" or "https")
                {
                    <a href="@url" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="@link.PlatformName" title="@link.PlatformName">
                        <i class="@(string.IsNullOrWhiteSpace(link.Icon) ? "bi bi-link-45deg" : link.Icon)" aria-hidden="true"></i>
                    </a>
                }
            }
                </div>
            </div>

            <!-- Right Visual with Portrait & Floating Badges -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="hero-image-wrapper">
                    <!-- Floating badge top left -->
                    <div class="floating-card float-top-left">
                        <div class="float-icon-box bg-icon-purple">
                            <i class="bi bi-code-slash"></i>
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">Clean Code</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">C# & ASP.NET Core</div>
                        </div>
                    </div>

                    <!-- Main Portrait -->
                    <div class="hero-image-frame">
                        @if (ViewBag.image is string image && !string.IsNullOrWhiteSpace(image))
                        {
                            <img src="@Url.Content(image)" alt="@Model.DisplayName" loading="lazy">
                        }
                    </div>

                    <!-- Floating badge bottom right -->
                    <div class="floating-card float-bottom-right">
                        <div class="float-icon-box bg-icon-mint">
                            <i class="bi bi-laptop"></i>
                        </div>
                        <div>
                            <div class="fw-bold small text-dark">Software Engineer</div>
                            <div class="text-secondary" style="font-size: 0.72rem;">Full Stack Developer</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
