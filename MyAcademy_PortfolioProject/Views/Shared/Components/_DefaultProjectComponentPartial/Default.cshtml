@model List<MyAcademy_PortfolioProject.Entities.Project>

<!-- Portfolio Projects Section -->
<section id="projects">
    <div class="container">
        <div class="text-center mb-4 reveal-on-scroll">
            <span class="section-eyebrow">SEÇİLMİŞ ÇALIŞMALAR</span>
            <h2 class="section-title">Projelerim</h2>
            <p class="section-subtitle">Öğrendiklerimi gerçek ürünlere dönüştürdüğüm çalışmalar.</p>
        </div>

        <!-- Category Filter Buttons -->
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 reveal-on-scroll" id="projectFilterGroup">
            <button class="filter-btn active" data-filter="all">Tümü</button>
            @foreach (var category in Model.Select(project => project.Category).DistinctBy(category => category.CategoryID).OrderBy(category => category.CategoryName))
            {
                <button type="button" class="filter-btn" data-filter="@category.CategoryID">@category.CategoryName</button>
            }
        </div>

        <!-- Project Cards Grid -->
        <div class="row g-4" id="projectGrid">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 project-item" data-category="@item.CategoryID">
                    <div class="project-card reveal-on-scroll">

                        <!-- Project Image -->
                        <div class="project-thumb"
                             style="width:100%; aspect-ratio:16/9; overflow:hidden;">

                            <img src="@Url.Content(item.CoverImgUrl ?? "~/images/projects/code.jpg")"
                                 alt="@item.Title"
                                 loading="lazy"
                                 style="width:100%;
                            height:100%;
                            object-fit:cover;
                            display:block;" />
                        </div>

                        <!-- Project Content -->
                        <div class="project-body">
                            <span class="project-category-badge">@item.Category.CategoryName</span>

                            <h3 class="project-title">@item.Title</h3>

                            <p class="project-desc">@item.Description</p>

                            @if (Uri.TryCreate(item.GithubUrl, UriKind.Absolute, out var repository) && repository.Scheme is "http" or "https")
                            {
                                <div class="project-footer">
                                    <a href="@repository" target="_blank" rel="noopener noreferrer" class="project-link-btn">
                                        <i class="bi bi-github" aria-hidden="true"></i> GitHub
                                    </a>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</section>


