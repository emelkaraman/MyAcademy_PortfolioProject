@model PortfolioHomeViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_DefaultHeadComponentPartial", new { settings = Model.Settings })

<body data-bs-spy="scroll" data-bs-target="#mainNavbar" data-bs-offset="100">

  

  <!-- Sticky Navbar -->
    @await Component.InvokeAsync("_DefaultNavbarComponentPartial", new { displayName = Model.DisplayName })

  <!-- Hero Section -->
    @await Component.InvokeAsync("_DefaultHeroSectionComponentPartial", new { home = Model })

  @if (Model.Skills.Count > 0)
  {
    <div class="marquee-container">
      <div class="marquee-track">
        @foreach (var skill in Model.Skills.Concat(Model.Skills))
        {
          <div class="marquee-item"><i class="bi bi-check2-circle"></i> @skill.SkillName</div>
        }
      </div>
    </div>
  }

  <!-- About Me Section -->
  <section id="about">
    <div class="container">
      <div class="text-center mb-5 reveal-on-scroll">
        <span class="section-eyebrow">BENİ TANIYIN</span>
        <h2 class="section-title">Hakkımda</h2>
        <p class="section-subtitle">Teknolojiye duyduğum merakı, insanlara değer katan yazılımlara dönüştürüyorum.</p>
      </div>
@if (Model.About is { } about)
{
    <div class="about-visual-box reveal-on-scroll">
      <h3>@about.NameSurname</h3>
      <p class="text-primary fw-semibold">@about.JobTitle</p>
      <p class="text-secondary">@about.Description</p>
      <p>@about.Expert</p>
      <p>@about.Location</p>
      <p>@about.OpenToWork</p>
      <a href="mailto:@about.Email">@about.Email</a>
    </div>
}
else
{
    <p class="text-secondary text-center">Henüz profil bilgisi eklenmedi.</p>
}
    </div>
  </section>

  <!-- Education Section -->
  <section id="education" style="background-color: var(--bg-secondary);">
    <div class="container">
      <div class="text-center mb-5 reveal-on-scroll">
        <span class="section-eyebrow">AKADEMİK YOLCULUĞUM</span>
        <h2 class="section-title">Eğitim Hayatım</h2>
        <p class="section-subtitle">Yazılım dünyasına uzanan yolculuğumun akademik temelleri.</p>
      </div>
<div class="timeline-container">
  @for (var index = 0; index < Model.Educations.Count; index++)
  {
    var item = Model.Educations[index];
    var sideClass = index % 2 == 0 ? "timeline-left" : "timeline-right offset-lg-6";
    <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
      <div class="col-lg-6 @sideClass">
        <div class="timeline-content-card">
          <span class="badge-year bg-icon-purple mb-2"><i class="bi bi-calendar3"></i> @item.Duration</span>
          <h3 class="fs-5 fw-bold mb-1">@item.Title</h3>
          <div class="text-primary fw-semibold small mb-2">@item.SubTitle</div>
          
          <p class="text-secondary small mb-0">@item.Description</p>
        </div>
      </div>
      <div class="timeline-marker"><i class="bi bi-mortarboard"></i></div>
    </div>
  }
  @if (Model.Educations.Count == 0)
  {
    <p class="text-secondary text-center">Henüz eğitim kaydı eklenmedi.</p>
  }
</div>
    </div>
  </section>

  <!-- Work Experience Section -->
  <section id="experience">
    <div class="container">
      <div class="text-center mb-5 reveal-on-scroll">
        <span class="section-eyebrow">PROFESYONEL YOLCULUK</span>
        <h2 class="section-title">Deneyimlerim</h2>
        <p class="section-subtitle">Gerçek dünya problemlerini çözerken edindiğim tecrübeler.</p>
      </div>
<div class="timeline-container">
  @for (var index = 0; index < Model.Experiences.Count; index++)
  {
    var item = Model.Experiences[index];
    var sideClass = index % 2 == 0 ? "timeline-left" : "timeline-right offset-lg-6";
    <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
      <div class="col-lg-6 @sideClass">
        <div class="timeline-content-card">
          <span class="badge-year bg-icon-purple mb-2"><i class="bi bi-calendar3"></i> @item.Duration</span>
          <h3 class="fs-5 fw-bold mb-1">@item.Title</h3>
          <div class="text-primary fw-semibold small mb-2">@item.CompanyName</div>
          <p class="small mb-2">@item.WorkType @item.SideTitle</p>
          <p class="text-secondary small mb-0">@item.Description</p>
        </div>
      </div>
      <div class="timeline-marker"><i class="bi bi-briefcase"></i></div>
    </div>
  }
  @if (Model.Experiences.Count == 0)
  {
    <p class="text-secondary text-center">Henüz deneyim kaydı eklenmedi.</p>
  }
</div>
    </div>
  </section>

  <!-- Technical Skills Section -->
  <section id="skills" style="background-color: var(--bg-secondary);">
    <div class="container">
      <div class="text-center mb-5 reveal-on-scroll">
        <span class="section-eyebrow">TEKNİK YETKİNLİKLER</span>
        <h2 class="section-title">Yeteneklerim</h2>
        <p class="section-subtitle">Fikirleri çalışan yazılımlara dönüştürürken kullandığım teknolojiler.</p>
      </div>
<div class="row g-4">
  @foreach (var skill in Model.Skills)
  {
    <div class="col-md-6 col-lg-4 reveal-on-scroll">
      <div class="skill-group-card">
        <div class="d-flex justify-content-between mb-2">
          <h3 class="fs-6 fw-bold mb-0">
            <i class="bi @(skill.SkillName switch
            {
                "GitHub" => "bi-github",
                "Git" => "bi-git",
                "MSSQL" => "bi-database",
                "Docker" => "bi-box-seam",
                "CI/CD" => "bi-arrow-repeat",
                _ => "bi-code-slash"
            }) me-2" aria-hidden="true"></i>@skill.SkillName
          </h3>
          <span>@skill.SkillLevel%</span>
        </div>
        <progress class="w-100" value="@skill.SkillLevel" max="100" aria-label="@skill.SkillName"></progress>
      </div>
    </div>
  }
  @if (Model.Skills.Count == 0)
  {
    <p class="text-secondary text-center">Henüz yetenek eklenmedi.</p>
  }
</div>
    </div>
  </section>

  <!-- Portfolio Projects Section -->
    @await Component.InvokeAsync("_DefaultProjectComponentPartial")

  <!-- Personal Workflow Section -->
  <section id="workflow" style="background-color: var(--bg-secondary);">
    <div class="container">
      <div class="text-center mb-5 reveal-on-scroll">
        <span class="section-eyebrow">NASIL ÇALIŞIYORUM?</span>
        <h2 class="section-title">Fikirden Ürüne Yolculuk</h2>
        <p class="section-subtitle">Her projeye planlı, sürdürülebilir ve kullanıcı odaklı bir yaklaşımla başlıyorum.</p>
      </div>

      <div class="row g-4 position-relative">
        <!-- Step 1 -->
        <div class="col-lg-3 col-md-6 reveal-on-scroll">
          <div class="workflow-step-card">
            <div class="workflow-num">01</div>
            <div class="float-icon-box bg-icon-purple mb-3">
              <i class="bi bi-search"></i>
            </div>
            <h4 class="fs-5 fw-bold mb-2">Analiz</h4>
            <p class="text-secondary small mb-0">İhtiyaçları ve hedefleri anlayarak doğru çözümü planlarım.</p>
            <div class="workflow-arrow d-none d-lg-flex">
              <i class="bi bi-arrow-right-short fs-5"></i>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="col-lg-3 col-md-6 reveal-on-scroll">
          <div class="workflow-step-card">
            <div class="workflow-num">02</div>
            <div class="float-icon-box bg-icon-blue mb-3">
              <i class="bi bi-palette"></i>
            </div>
            <h4 class="fs-5 fw-bold mb-2">Tasarım</h4>
            <p class="text-secondary small mb-0">Uygulama mimarisini ve kullanıcı deneyimini şekillendiririm.</p>
            <div class="workflow-arrow d-none d-lg-flex">
              <i class="bi bi-arrow-right-short fs-5"></i>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="col-lg-3 col-md-6 reveal-on-scroll">
          <div class="workflow-step-card">
            <div class="workflow-num">03</div>
            <div class="float-icon-box bg-icon-mint mb-3">
              <i class="bi bi-code-square"></i>
            </div>
            <h4 class="fs-5 fw-bold mb-2">Geliştirme</h4>
            <p class="text-secondary small mb-0">Temiz, sürdürülebilir ve ölçeklenebilir kod geliştiririm.</p>
            <div class="workflow-arrow d-none d-lg-flex">
              <i class="bi bi-arrow-right-short fs-5"></i>
            </div>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="col-lg-3 col-md-6 reveal-on-scroll">
          <div class="workflow-step-card">
            <div class="workflow-num">04</div>
            <div class="float-icon-box bg-icon-peach mb-3">
              <i class="bi bi-check2-circle"></i>
            </div>
            <h4 class="fs-5 fw-bold mb-2">Test ve İyileştirme</h4>
            <p class="text-secondary small mb-0">Kalite, performans ve kullanılabilirlik odaklı testler gerçekleştiririm.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications Section -->

  <!-- Contact Section -->
  <section id="contact" style="background-color: var(--bg-secondary);">
    <div class="container">
      <div class="text-center mb-5 reveal-on-scroll">
        <span class="section-eyebrow">İLETİŞİME GEÇELİM</span>
        <h2 class="section-title">Birlikte Harika İşler Üretebiliriz.</h2>
        <p class="section-subtitle">Yeni projeler, iş birlikleri veya yalnızca merhaba demek için benimle iletişime geçebilirsiniz.</p>
      </div>

      <div class="row g-5">
        <!-- Left: Contact Details -->
        <div class="col-lg-5 reveal-on-scroll">
          <div class="contact-info-card">
            <h3 class="fs-4 fw-bold mb-3">İletişim Bilgileri</h3>
            @if (Model.Contact is { } contact)
            {
                <p class="text-secondary">@contact.Description</p>
                <p><a href="mailto:@contact.Email">@contact.Email</a></p>
                <p>@contact.Locatioan</p>
                <p>@contact.SubDescription</p>
                @if (Uri.TryCreate(contact.Linkedin, UriKind.Absolute, out var linkedIn) && linkedIn.Scheme is "http" or "https")
                {
                    <a href="@linkedIn" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                }
                @if (Uri.TryCreate(contact.Github, UriKind.Absolute, out var github) && github.Scheme is "http" or "https")
                {
                    <a href="@github" target="_blank" rel="noopener noreferrer">GitHub</a>
                }
            }
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="col-lg-7 reveal-on-scroll">
          <div class="contact-form-card">
            <form asp-controller="Default" asp-action="SendMessage" asp-fragment="contact" method="post">
              <div hidden>
                <label for="contactWebsite">Web sitesi</label>
                <input type="text" id="contactWebsite" name="website" tabindex="-1" autocomplete="off">
              </div>
              @if (TempData["ContactSuccess"] is string successMessage)
              {
                  <div class="alert alert-success" role="status">@successMessage</div>
              }

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="contactFullName" class="form-label">Adınız Soyadınız *</label>
                  <input type="text" class="form-control" id="contactFullName" asp-for="ContactMessage.NameSurname" placeholder="Örn: Ahmet Yılmaz" required>
                  <span asp-validation-for="ContactMessage.NameSurname" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                  <label for="contactEmail" class="form-label">E-posta Adresiniz *</label>
                  <input type="email" class="form-control" id="contactEmail" asp-for="ContactMessage.Email" placeholder="Örn: ahmet@example.com" required>
                  <span asp-validation-for="ContactMessage.Email" class="text-danger"></span>
                </div>

                <div class="col-12">
                  <label for="contactSubject" class="form-label">Konu *</label>
                  <input type="text" class="form-control" id="contactSubject" asp-for="ContactMessage.Subject" placeholder="Örn: Proje İş Birliği veya Danışmanlık" required>
                  <span asp-validation-for="ContactMessage.Subject" class="text-danger"></span>
                </div>

                <div class="col-12">
                  <label for="contactMessage" class="form-label">Mesajınız *</label>
                  <textarea class="form-control" id="contactMessage" asp-for="ContactMessage.MessageDetail" rows="5" placeholder="Projeniz veya paylaşmak istedikleriniz hakkında detay verebilirsiniz..." required></textarea>
                  <span asp-validation-for="ContactMessage.MessageDetail" class="text-danger"></span>
                </div>

                <div class="col-12 mt-4">
                  <button type="submit" class="btn-custom-primary w-100 justify-content-center py-3">
                    <i class="bi bi-send-fill"></i> Mesaj Gönder
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="row g-4 align-items-center mb-5">
        <!-- Col 1: Brand -->
        <div class="col-lg-4 text-center text-lg-start">
          <a class="navbar-brand d-inline-flex align-items-center mb-2" href="#home">
            <span class="brand-mark">@Model.DisplayName[0]</span>
            <span class="brand-name">@Model.DisplayName<span>.</span></span>
          </a>
          <p class="text-secondary small mb-0">Teknoloji, tasarım ve yaratıcılıkla geliştirildi.</p>
        </div>

        <!-- Col 2: Navigation Links -->
        <div class="col-lg-4 text-center">
          <ul class="list-inline mb-0">
            <li class="list-inline-item mx-2"><a href="#home" class="footer-link">Ana Sayfa</a></li>
            <li class="list-inline-item mx-2"><a href="#about" class="footer-link">Hakkımda</a></li>
            <li class="list-inline-item mx-2"><a href="#projects" class="footer-link">Projelerim</a></li>
            <li class="list-inline-item mx-2"><a href="#contact" class="footer-link">İletişim</a></li>
          </ul>
        </div>

        <!-- Col 3: Social Links -->
        <div class="col-lg-4 text-center text-lg-end">
          <div class="d-inline-flex gap-2">
            @foreach (var link in Model.SocialLinks)
            {
                if (Uri.TryCreate(link.Url, UriKind.Absolute, out var url) && url.Scheme is "http" or "https")
                {
                    <a href="@url" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="@link.PlatformName" title="@link.PlatformName">
                        <i class="@(string.IsNullOrWhiteSpace(link.Icon) ? "bi bi-link-45deg" : link.Icon)" aria-hidden="true"></i>
                    </a>
                }
            }
          </div>
        </div>
      </div>

      <hr class="text-secondary opacity-25 mb-4">

      <div class="text-center">
        <p class="text-secondary small mb-0">© @DateTime.Now.Year @Model.DisplayName. Tüm hakları saklıdır.</p>
      </div>
    </div>
  </footer>

  <!-- Scroll To Top Button -->
  <button id="scrollToTopBtn" class="scroll-to-top" aria-label="Sayfanın Başına Çık">
    <i class="bi bi-chevron-up"></i>
  </button>

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Vanilla JavaScript Logic -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      
      // 1. TYPING ANIMATION (Turkish sentences, letter-by-letter, infinite loop)
      const sentences = [
        "Modern Web Uygulamaları Geliştiriyorum.",
        "Yazılımla Problemlere Çözüm Üretiyorum.",
        "Kullanıcı Odaklı Deneyimler Tasarlıyorum.",
        "Yeni Teknolojilerle Geleceği İnşa Ediyorum."
      ];

      const typedTextElement = document.getElementById('typedText');
      let sentenceIndex = 0;
      let charIndex = 0;
      let isDeleting = false;
      const typeSpeed = 75;      // 60-90ms typing delay
      const backSpeed = 40;      // deleting speed
      const waitTime = 1800;     // ~1800ms display time once finished

      function typeLoop() {
        const currentSentence = sentences[sentenceIndex];

        if (isDeleting) {
          typedTextElement.textContent = currentSentence.substring(0, charIndex - 1);
          charIndex--;
        } else {
          typedTextElement.textContent = currentSentence.substring(0, charIndex + 1);
          charIndex++;
        }

        let currentDelay = isDeleting ? backSpeed : typeSpeed;

        if (!isDeleting && charIndex === currentSentence.length) {
          currentDelay = waitTime;
          isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          sentenceIndex = (sentenceIndex + 1) % sentences.length;
          currentDelay = 350; // pause before next sentence
        }

        setTimeout(typeLoop, currentDelay);
      }

      if (typedTextElement) {
        setTimeout(typeLoop, 500);
      }

      // 2. NAVBAR SCROLL EFFECT & SCROLL TO TOP VISIBILITY
      const navbar = document.getElementById('mainNavbar');
      const scrollTopBtn = document.getElementById('scrollToTopBtn');

      window.addEventListener('scroll', function () {
        if (window.scrollY > 50) {
          navbar.classList.add('scrolled');
          scrollTopBtn.classList.add('visible');
        } else {
          navbar.classList.remove('scrolled');
          scrollTopBtn.classList.remove('visible');
        }
      }, { passive: true });

      // Scroll to Top action
      if (scrollTopBtn) {
        scrollTopBtn.addEventListener('click', function () {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }

      // Close mobile navbar on nav-link click
      const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
      const navbarCollapse = document.getElementById('navbarContent');
      navLinks.forEach(function (link) {
        link.addEventListener('click', function () {
          if (window.innerWidth < 992 && navbarCollapse.classList.contains('show')) {
            const bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
            if (bsCollapse) {
              bsCollapse.hide();
            }
          }
        });
      });

      // 3. PROJECT FILTERING (Vanilla JS, data-category)
      const filterButtons = document.querySelectorAll('#projectFilterGroup .filter-btn');
      const projectItems = document.querySelectorAll('.project-item');

      filterButtons.forEach(button => {
        button.addEventListener('click', function () {
          filterButtons.forEach(btn => btn.classList.remove('active'));
          this.classList.add('active');

          const filterValue = this.getAttribute('data-filter');

          projectItems.forEach(item => {
            const itemCategory = item.getAttribute('data-category');
            if (filterValue === 'all' || itemCategory === filterValue) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });

      // 4. SCROLL REVEAL (IntersectionObserver)
      const revealElements = document.querySelectorAll('.reveal-on-scroll');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              obs.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.12,
          rootMargin: "0px 0px -40px 0px"
        });

        revealElements.forEach(el => observer.observe(el));
      } else {
        // Fallback for older browsers
        revealElements.forEach(el => el.classList.add('revealed'));
      }

    });
  </script>
</body>
</html>
