@model List<MyAcademy_PortfolioProject.Entities.SocialMedia>

@{
    ViewData["Title"] = "Sosyal Medya Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <a asp-area="Admin"
           asp-controller="SocialMedia"
           asp-action="CreateSocialMedia"
           class="btn btn-success">
            + Yeni Hesap Ekle
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Platform</th>
                <th>URL</th>
                <th>İkon</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PlatformName</td>
                    <td>
                        <a href="@item.Url" target="_blank"
                           rel="noopener noreferrer">
                            Bağlantıyı Aç
                        </a>
                    </td>
                    <td>@item.Icon</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-area="Admin"
                               asp-controller="SocialMedia"
                               asp-action="UpdateSocialMedia"
                               asp-route-id="@item.SocialMediaID"
                               class="btn btn-warning btn-sm">
                                Güncelle
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="SocialMedia"
                                  asp-action="DeleteSocialMedia"
                                  asp-route-id="@item.SocialMediaID"
                                  method="post"
                                  onsubmit="return confirm('Bu hesabı silmek istiyor musunuz?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz sosyal medya hesabı eklenmemiş.
        </div>
    }

</div>
