@model MyAcademy_PortfolioProject.Entities.Skill

@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="Skill"
                  asp-action="UpdateSkill"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="SkillID" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="SkillName" class="form-label">
                        Yetenek Adı
                    </label>
                    <input asp-for="SkillName"
                           class="form-control" />
                    <span asp-validation-for="SkillName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SkillLevel" class="form-label">
                        Yetenek Seviyesi (0-100)
                    </label>
                    <input asp-for="SkillLevel"
                           type="number"
                           min="0"
                           max="100"
                           class="form-control" />
                    <span asp-validation-for="SkillLevel"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">
                    Güncelle
                </button>

                <a asp-action="SkillList"
                   class="btn btn-secondary">
                    İptal
                </a>

            </form>
        </div>
    </div>
</div>
