@model List<MyAcademy_PortfolioProject.Entities.Category>

@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Kategori Listesi</h4>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="CreateCategory"
           class="btn btn-success">
            + Yeni Kategori Ekle
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Kategori Adı</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryID</td>
                    <td>@item.CategoryName</td>
                    <td>
                        <form asp-area="Admin"
                              asp-controller="Category"
                              asp-action="DeleteCategory"
                              asp-route-id="@item.CategoryID"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger btn-sm">
                                Sil
                            </button>
                        </form>
                    </td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Category"
                           asp-action="UpdateCategory"
                           asp-route-id="@item.CategoryID"
                           class="btn btn-success btn-sm">
                            Güncelle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

