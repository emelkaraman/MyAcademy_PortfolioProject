@model List<MyAcademy_PortfolioProject.Entities.Testimonial>

@{
    ViewData["Title"] = "Referans Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <a asp-area="Admin"
           asp-controller="Testimonial"
           asp-action="CreateTestimonial"
           class="btn btn-success">
            + Yeni Referans Ekle
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Görsel</th>
                <th>Ad Soyad</th>
                <th>Meslek</th>
                <th>Yorum</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 width="55"
                                 height="55"
                                 style="object-fit:cover; border-radius:50%;" />
                        }
                    </td>

                    <td>@item.NameSurname</td>
                    <td>@item.JobTitle</td>

                    <td>
                        @(item.Comment.Length > 80
                            ? item.Comment.Substring(0, 80) + "..."
                            : item.Comment)
                    </td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </td>

                    <td>
                        <div class="d-flex gap-2">
                            <a asp-area="Admin"
                               asp-controller="Testimonial"
                               asp-action="UpdateTestimonial"
                               asp-route-id="@item.TestimonialID"
                               class="btn btn-warning btn-sm">
                                Güncelle
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="Testimonial"
                                  asp-action="DeleteTestimonial"
                                  asp-route-id="@item.TestimonialID"
                                  method="post"
                                  onsubmit="return confirm('Bu referansı silmek istiyor musunuz?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz referans eklenmemiş.
        </div>
    }

</div>
