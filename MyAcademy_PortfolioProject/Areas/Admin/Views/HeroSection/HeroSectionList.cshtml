@model List<MyAcademy_PortfolioProject.Entities.HeroSection>

@{
    ViewData["Title"] = "Giriş Bölümü";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        @if (Model.Count == 0)
        {
            <a asp-area="Admin"
               asp-controller="HeroSection"
               asp-action="CreateHeroSection"
               class="btn btn-success">
                + Giriş Bilgisi Ekle
            </a>
        }
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Görsel</th>
                <th>Başlık</th>
                <th>Alt Başlık</th>
                <th>Durum</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 width="80"
                                 height="50"
                                 style="object-fit:cover;" />
                        }
                    </td>

                    <td>@item.Title</td>
                    <td>@item.Subtitle</td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </td>

                    <td>
                        <a asp-area="Admin"
                           asp-controller="HeroSection"
                           asp-action="UpdateHeroSection"
                           asp-route-id="@item.HeroSectionId"
                           class="btn btn-success btn-sm">
                            Güncelle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz giriş bilgisi eklenmemiş.
        </div>
    }

</div>
