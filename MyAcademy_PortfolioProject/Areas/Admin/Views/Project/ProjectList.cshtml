@model List<MyAcademy_PortfolioProject.Entities.Project>

@{
    ViewData["Title"] = "Proje Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <a asp-area="Admin"
           asp-controller="Project"
           asp-action="CreateProject"
           class="btn btn-success">
            + Yeni Proje Ekle
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Görsel</th>
                <th>Proje Adı</th>
                <th>Kategori</th>
                <th>Durum</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProjectID</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.CoverImgUrl))
                        {
                            <img src="@item.CoverImgUrl"
                                 width="80"
                                 height="50"
                                 style="object-fit:cover;" />
                        }
                    </td>

                    <td>@item.Title</td>
                    <td>@item.Category?.CategoryName</td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </td>

                    <td>
                        <form asp-area="Admin"
                              asp-controller="Project"
                              asp-action="DeleteProject"
                              asp-route-id="@item.ProjectID"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Sil
                            </button>
                        </form>
                    </td>

                    <td>
                        <a asp-area="Admin"
                           asp-controller="Project"
                           asp-action="UpdateProject"
                           asp-route-id="@item.ProjectID"
                           class="btn btn-success btn-sm">
                            Güncelle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
