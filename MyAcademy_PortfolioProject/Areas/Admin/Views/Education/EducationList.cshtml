@model List<MyAcademy_PortfolioProject.Entities.Education>

@{
    ViewData["Title"] = "Eğitim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <h3>Eğitim Bilgileri</h3>
    <hr />

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Başlık</th>
                <th>Alt Başlık</th>
                <th>Açıklama</th>
                <th>Süre</th>
                <th>Durum</th>
                <th>Sil</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EducationId</td>
                    <td>@item.Title</td>
                    <td>@item.SubTitle</td>
                    <td>@item.Description</td>
                    <td>@item.Duration</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </td>
                    <td>
                        <form asp-area="Admin"
                              asp-controller="Education"
                              asp-action="DeleteEducation"
                              asp-route-id="@item.EducationId"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">
                                Sil
                            </button>
                        </form>
                    </td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Education"
                           asp-action="UpdateEducation"
                           asp-route-id="@item.EducationId"
                           class="btn btn-success btn-sm">
                            Güncelle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz eğitim bilgisi eklenmemiş.
        </div>
    }

    <a asp-area="Admin"
       asp-controller="Education"
       asp-action="CreateEducation"
       class="btn btn-primary">
        Yeni Eğitim Ekle
    </a>
</div>
