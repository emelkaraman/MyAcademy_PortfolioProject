@model List<MyAcademy_PortfolioProject.Entities.Contact>

@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>İletişim Bilgileri</h4>

        @if (Model.Count == 0)
        {
            <a asp-area="Admin"
               asp-controller="Contact"
               asp-action="CreateContact"
               class="btn btn-success">
                + İletişim Bilgisi Ekle
            </a>
        }
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>E-posta</th>
                <th>Konum</th>
                <th>LinkedIn</th>
                <th>GitHub</th>
                <th>Güncelle</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Email</td>
                    <td>@item.Locatioan</td>
                    <td>@item.Linkedin</td>
                    <td>@item.Github</td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Contact"
                           asp-action="UpdateContact"
                           asp-route-id="@item.ContactId"
                           class="btn btn-success btn-sm">
                            Güncelle
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz iletişim bilgisi eklenmemiş.
        </div>
    }

</div>
