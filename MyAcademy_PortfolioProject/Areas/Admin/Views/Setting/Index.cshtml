@model MyAcademy_PortfolioProject.Entities.Setting

@{
    ViewData["Title"] = "Site Ayarları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@section Styles {
    <style>
        .settings-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-subtle);
            overflow: hidden;
        }

        .settings-header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 22px 26px;
            border-bottom: 1px solid var(--border-color);
        }

        .settings-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: var(--pastel-purple);
            color: var(--primary-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .settings-body {
            padding: 26px;
        }

        .settings-footer {
            padding: 18px 26px;
            background: #FAFBFE;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
        }

        .settings-label {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .settings-input {
            border: 1px solid #DCE1ED;
            border-radius: 10px;
            padding: 11px 14px;
            font-size: 0.9rem;
        }

            .settings-input:focus {
                border-color: var(--primary-accent);
                box-shadow: 0 0 0 3px rgba(130,118,217,0.12);
            }

        .settings-help {
            font-size: 0.78rem;
            color: var(--text-secondary);
            margin-top: 6px;
        }

        .btn-save {
            background: var(--primary-accent);
            border: none;
            color: #fff;
            border-radius: 10px;
            padding: 11px 24px;
            font-weight: 600;
        }

            .btn-save:hover {
                background: var(--primary-accent-hover);
                color: #fff;
            }

        .settings-info {
            background: #F4F1FF;
            border: 1px solid #E8E2FF;
            border-radius: 12px;
            padding: 18px;
            font-size: 0.85rem;
            color: #55516D;
        }
    </style>
}

<div class="row g-4">

    <div class="col-lg-8">

        <div class="settings-card">

            <div class="settings-header">
                <div class="settings-icon">
                    <i class="bi bi-gear"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">Genel Site Ayarları</h5>
                    <small class="text-secondary">
                        Portfolyonuzun genel bilgilerini buradan yönetin.
                    </small>
                </div>
            </div>

            <form asp-area="Admin"
                  asp-controller="Setting"
                  asp-action="Index"
                  enctype="multipart/form-data"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="settings-body">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            @TempData["Success"]
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="SettingID" />

                    <div class="mb-4">
                        <label asp-for="SiteTitle" class="settings-label">
                            Site Başlığı <span class="text-danger">*</span>
                        </label>

                        <input asp-for="SiteTitle"
                               class="form-control settings-input"
                               placeholder="Örn: Kişisel Portfolyom" />

                        <span asp-validation-for="SiteTitle"
                              class="text-danger small"></span>

                        <div class="settings-help">
                            Tarayıcı sekmesinde ve site başlığında
                            kullanılabilecek metin.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SiteDescription" class="settings-label">
                            Site Açıklaması
                        </label>

                        <textarea asp-for="SiteDescription"
                                  class="form-control settings-input"
                                  rows="4"
                                  placeholder="Portfolyonuz hakkında kısa bir açıklama..."></textarea>

                        <span asp-validation-for="SiteDescription"
                              class="text-danger small"></span>

                        <div class="settings-help">
                            Sitenizin genel tanıtım metni.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="cvFile" class="settings-label">
                            CV Dosyası
                        </label>

                        <input type="file" id="cvFile" name="cvFile" accept=".pdf,application/pdf"
                               class="form-control settings-input"
                               />

                        @Html.ValidationMessage("cvFile", null, new { @class = "text-danger small" })

                        <div class="settings-help">
                            En fazla 10 MB boyutunda bir PDF yükleyebilirsin. Dosya seçmezsen mevcut CV kullanılır.
                            <a asp-area="" asp-controller="Default" asp-action="DownloadCv">Mevcut CV’yi indir</a>
                        </div>
                    </div>

                </div>

                <div class="settings-footer">
                    <button type="submit" class="btn btn-save">
                        <i class="bi bi-check2-circle me-2"></i>
                        Değişiklikleri Kaydet
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="col-lg-4">

        <div class="settings-info">
            <h6 class="fw-bold mb-3">
                <i class="bi bi-info-circle me-2"></i>
                Bilgilendirme
            </h6>

            <p>
                <i class="bi bi-check-circle me-2"></i>
                Site ayarları veritabanında saklanır.
            </p>

            <p>
                <i class="bi bi-check-circle me-2"></i>
                Değişiklikler kaydedildiğinde mevcut ayarlar güncellenir.
            </p>

            <p class="mb-0">
                <i class="bi bi-file-earmark-pdf me-2"></i>
                CV dosyasını yükleme ve indirme özelliği
                ayrıca eklenecektir.
            </p>
        </div>

    </div>

</div>
